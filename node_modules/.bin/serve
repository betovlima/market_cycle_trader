if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/runner/work/market_cycle_trader/market_cycle_trader/node_modules/.pnpm/serve@14.2.6_supports-color@7.2.0/node_modules/serve/build/node_modules:/home/runner/work/market_cycle_trader/market_cycle_trader/node_modules/.pnpm/serve@14.2.6_supports-color@7.2.0/node_modules/serve/node_modules:/home/runner/work/market_cycle_trader/market_cycle_trader/node_modules/.pnpm/serve@14.2.6_supports-color@7.2.0/node_modules:/home/runner/work/market_cycle_trader/market_cycle_trader/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/runner/work/market_cycle_trader/market_cycle_trader/node_modules/.pnpm/serve@14.2.6_supports-color@7.2.0/node_modules/serve/build/node_modules:/home/runner/work/market_cycle_trader/market_cycle_trader/node_modules/.pnpm/serve@14.2.6_supports-color@7.2.0/node_modules/serve/node_modules:/home/runner/work/market_cycle_trader/market_cycle_trader/node_modules/.pnpm/serve@14.2.6_supports-color@7.2.0/node_modules:/home/runner/work/market_cycle_trader/market_cycle_trader/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../serve/build/main.js" "$@"
else
  exec node  "$basedir/../serve/build/main.js" "$@"
fi
